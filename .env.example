# Copy to `.env` and fill secrets. Never commit `.env`.

DATABASE_URL="postgresql://delepe:delepe@localhost:5432/delepe"
SESSION_SECRET="replace-with-at-least-32-bytes-secret!!"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-now"
# MASTER_USERNAME=
# MASTER_PASSWORD=
# SEED_DOWNLOAD_IMAGES=false
# STORAGE_ROOT: production Docker default is /data/storage (volume).
# Windows / local development: override with a relative path so the folder
# is created inside the repo (forward slashes work in Node on Windows).
# STORAGE_ROOT="./storage"
# STORAGE_ROOT=/data/storage
# E2E against compose profile `test` (host 5433). CI should override this.
# E2E_DATABASE_URL="postgresql://delepe:delepe@localhost:5433/delepe_test"
# E2E_PORT=3100
