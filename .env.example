# Copy to `.env` and fill secrets. Never commit `.env`.

# Postgres (required). Local: localhost:5432. Docker Compose app service
# overrides this to host `db` automatically.
DATABASE_URL="postgresql://delepe:delepe@localhost:5432/delepe"

# JWT session signing key. Must be at least 32 characters (docs/10).
# Production Compose refuses this example string — generate a unique value:
#   openssl rand -base64 48
SESSION_SECRET="replace-with-at-least-32-bytes-secret!!"

# Used only when the database has zero admin users (first seed / empty DB).
# Production Compose refuses ADMIN_PASSWORD=change-me-now.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-now"

# Optional recovery backdoor accepted by login when BOTH are set (docs/10).
# Remove these lines when not needed.
# MASTER_USERNAME=
# MASTER_PASSWORD=

# Uploads directory. Production Docker default is /data/storage (named volume).
# Windows / local development: a relative path is created inside the repo.
# STORAGE_ROOT="./storage"
# STORAGE_ROOT=/data/storage

# App listen port (default 3000).
# PORT=3000

# Compose Postgres password (db + app DATABASE_URL). Default: delepe.
# POSTGRES_PASSWORD=delepe
# Bind Postgres on the host (default 5432, localhost only).
# POSTGRES_PUBLISH_PORT=5432

# Caddy site address. Default HTTP on :80 (bare IP). Set a hostname for auto-TLS.
# CADDY_SITE=http://:80
# CADDY_SITE=menu.example.com

# E2E against compose profile `test` (host 5433). CI overrides this.
# E2E_DATABASE_URL="postgresql://delepe:delepe@localhost:5433/delepe_test"
# E2E_PORT=3100
